# name: test/sql/sax_attr_only_empty.test
# description: SAX must extract an element that carries its own attributes the way DOM does. An empty attribute-only element (Atom <link rel href/>) infers as a STRUCT of its attributes on both paths, and a scalar column reads the element's text converted to the column type. Regression for: SAX returned the raw captured payload, so the attribute-only element read '' where DOM read NULL, a VARCHAR kept its escaped text, and a typed column read NULL.
# group: [sql]

require webbed

query TTTTT
SELECT title, typeof(link), link IS NULL, link.href, link.rel
FROM read_xml('test/xml/sax_attr_only_empty.xml', record_element := 'entry') ORDER BY title;
----
a	STRUCT(href VARCHAR, rel VARCHAR)	false	http://x/a	alternate
b	STRUCT(href VARCHAR, rel VARCHAR)	false	http://x/b	alternate

query TTTTT
SELECT title, typeof(link), link IS NULL, link.href, link.rel
FROM read_xml('test/xml/sax_attr_only_empty.xml', record_element := 'entry', maximum_file_size := 1) ORDER BY title;
----
a	STRUCT(href VARCHAR, rel VARCHAR)	false	http://x/a	alternate
b	STRUCT(href VARCHAR, rel VARCHAR)	false	http://x/b	alternate

# Attribute-bearing elements in scalar columns read their text content, converted to the column type
query III
SELECT n, s, d FROM read_xml('test/xml/sax_attr_scalar.xml', record_element := 'rec',
  columns := {'n': 'INTEGER', 's': 'VARCHAR', 'd': 'DATE'});
----
5	x & y	2024-01-02

query III
SELECT n, s, d FROM read_xml('test/xml/sax_attr_scalar.xml', record_element := 'rec', maximum_file_size := 1,
  columns := {'n': 'INTEGER', 's': 'VARCHAR', 'd': 'DATE'});
----
5	x & y	2024-01-02
